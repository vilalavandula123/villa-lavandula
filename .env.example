# Копирайте този файл като .env.local и попълнете стойностите. НЕ качвайте .env.local в публично хранилище.

# Публичен адрес на сайта (за canonical, sitemap и споделяне). Собствен домейн още не е потвърден.
SITE_URL=http://localhost:3000

# true само при окончателно публикуване. Дотогава сайтът казва на търсачките да не го индексират.
SITE_INDEXABLE=false

# --- Изпращане на запитвания (SMTP) ---
# Ако някое от SMTP_HOST, SMTP_USER, SMTP_PASS, MAIL_FROM, ENQUIRY_TO липсва,
# формата честно показва, че онлайн изпращането не е активно, и предлага телефон и имейл.
SMTP_HOST=
SMTP_PORT=587
# true за порт 465 (SSL), false за 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Подател от домейн с настроени SPF/DKIM/DMARC, напр. "Вила Лавандула <zapitvania@ваш-домейн.bg>"
MAIL_FROM=
# Получател на запитванията (собственикът)
ENQUIRY_TO=
# true = гостът получава кратко автоматично потвърждение, че запитването е получено (без обещание за наличност)
ENQUIRY_GUEST_CONFIRMATION=false

# Защита от злоупотреби: максимален брой запитвания от един IP адрес за 10 минути
ENQUIRY_RATE_LIMIT=5
