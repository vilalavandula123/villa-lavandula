# Настройки на сайта. В Cloudflare несекретните стойности са в wrangler.jsonc ("vars"),
# а RESEND_API_KEY се добавя като Secret: Workers & Pages → villa-lavandula → Settings → Variables and Secrets.
# За локална работа копирайте този файл като .env.local. НЕ качвайте .env.local в GitHub.

SITE_URL=https://villa-lavandula.com
# false = търсачките не индексират (за тестова версия)
SITE_INDEXABLE=true

# --- Изпращане на запитвания чрез Resend (https://resend.com) ---
# Ако RESEND_API_KEY, MAIL_FROM или ENQUIRY_TO липсва, формата честно показва,
# че онлайн изпращането не е активно, и предлага телефон и имейл.
RESEND_API_KEY=
# Подател от потвърден в Resend домейн
MAIL_FROM=Вила Лавандула <zapitvania@villa-lavandula.com>
# Получател на запитванията (може няколко, разделени със запетая)
ENQUIRY_TO=
# true = гостът получава кратко потвърждение, че запитването е получено (без обещание за наличност)
ENQUIRY_GUEST_CONFIRMATION=true
