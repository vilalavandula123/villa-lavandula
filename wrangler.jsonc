// Настройки за Cloudflare Workers (безплатен план). Сайтът се сглобява с OpenNext.
// Тайните (RESEND_API_KEY) НЕ се пишат тук — задават се в Cloudflare като Secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "villa-lavandula",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "villa-lavandula" }],
  // Собственият домейн (домейнът е в същия Cloudflare профил)
  "routes": [
    { "pattern": "villa-lavandula.com", "custom_domain": true },
    { "pattern": "www.villa-lavandula.com", "custom_domain": true }
  ],
  // Ограничение: до 5 запитвания на минута от един IP адрес
  "ratelimits": [
    { "name": "ENQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Не трий променливите, добавени ръчно в Cloudflare, при всяко публикуване
  "keep_vars": true,
  "vars": {
    "SITE_URL": "https://villa-lavandula.com",
    "SITE_INDEXABLE": "true",
    "MAIL_FROM": "Вила Лавандула <zapitvania@villa-lavandula.com>",
    "ENQUIRY_TO": "b.r.mihaylov@gmail.com",
    "ENQUIRY_GUEST_CONFIRMATION": "true"
  },
  "observability": { "enabled": true }
}
